{
  "info": {
    "name": "Parser Service",
    "description": "Requests for the Parser Service API. Set `baseUrl` (default http://localhost:8000), start the API and the worker, then run the requests in order. Use synthetic files only, never real data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health and metrics",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "description": "The process is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Database, storage and disk are ready to take jobs. 503 when not ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Prometheus metrics: counts and timings only, never document content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Supported formats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/formats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "formats"
              ]
            },
            "description": "Formats the parser can extract today, and the parser version."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lists formats\", () => pm.expect(pm.response.json().formats).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Parse jobs",
      "item": [
        {
          "name": "Submit a file",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs"
              ]
            },
            "description": "Upload a file (form field `file`). Returns 202 and a job ID. Pick any synthetic file, for example tests/corpus/md/normal/guide.md. Submitting the same file again with the same parser version returns the existing job (`already_existed: true`). The test script stores the job ID in the `jobId` collection variable.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "password",
                  "type": "text",
                  "value": "",
                  "disabled": true,
                  "description": "Optional: password for an encrypted file. Tick the row to send it."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted or 200 for an existing job\", () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "const body = pm.response.json();",
                  "pm.test(\"has a job ID\", () => pm.expect(body.job_id).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"jobId\", body.job_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Job status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs",
                "{{jobId}}"
              ]
            },
            "description": "Status of the job submitted above: queued, running, succeeded, partial or failed (with a failure reason). Run it again until the worker has finished."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"status is known\", () => pm.expect(body.status).to.be.oneOf([\"queued\", \"running\", \"succeeded\", \"partial\", \"failed\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Job result (JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs/{{jobId}}/result",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs",
                "{{jobId}}",
                "result"
              ]
            },
            "description": "The ParsedDocument of the submitted job: elements with locators, outline, warnings and metrics. Returns 409 until the worker has finished; run Job status first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 when finished, 409 while still running\", () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Job result (Markdown)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs/{{jobId}}/result.md",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs",
                "{{jobId}}",
                "result.md"
              ]
            },
            "description": "The same result rendered as Markdown. Returns 409 until the worker has finished."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 when finished, 409 while still running\", () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry a failed job",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs/{{jobId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs",
                "{{jobId}}",
                "retry"
              ]
            },
            "description": "Puts a failed job back in the queue (202). Any other job answers 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 for a failed job, 409 otherwise\", () => pm.expect(pm.response.code).to.be.oneOf([202, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "List failed jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs?status=failed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "failed"
                }
              ]
            },
            "description": "Lists persisted failed jobs and their failure reasons."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown job returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs",
                "00000000-0000-4000-8000-000000000000"
              ]
            },
            "description": "Every error has a code from a fixed enum, a message and a request ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"error has a request ID\", () => pm.expect(pm.response.json().request_id).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs",
                "{{jobId}}"
              ]
            },
            "description": "Removes the file, the result and the job record together (204). Run it last."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Parse batches",
      "item": [
        {
          "name": "Submit several files",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-jobs"
              ]
            },
            "description": "Upload two or more files at once: add a file to every `file` row (one per row; add rows for more). Returns 202 with a batch ID and one job per file. Workers parse the files in parallel. The test script stores the batch ID in the `batchId` collection variable.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "password",
                  "value": "",
                  "type": "text",
                  "disabled": true,
                  "description": "Optional shared password for encrypted PDF files in this batch."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"has a batch ID\", () => pm.expect(body.batch_id).to.be.a(\"string\"));",
                  "pm.test(\"one entry per file\", () => pm.expect(body.files).to.be.an(\"array\"));",
                  "pm.collectionVariables.set(\"batchId\", body.batch_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Batch status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-batches/{{batchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-batches",
                "{{batchId}}"
              ]
            },
            "description": "Overall status (running, succeeded, partial or failed) and every file's job status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lists every file\", () => pm.expect(pm.response.json().files).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Batch result (combined)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/parse-batches/{{batchId}}/result",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "parse-batches",
                "{{batchId}}",
                "result"
              ]
            },
            "description": "One combined JSON: for every file its parsed document (`result`) or its `failure_reason`. Returns 409 until every file has finished; run Batch status first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 when every file has finished, 409 before\", () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "batchId",
      "value": ""
    }
  ]
}
