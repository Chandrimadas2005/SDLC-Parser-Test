# Copy to .env for local overrides. Every value here is synthetic. Never commit a real .env.
# Variable names are the EnvironmentVariable enum in src/ParserService/Infrastructure/Config.

# --- Database (docker compose builds PARSER_DATABASE_URL from these) ---------------------
POSTGRES_DB=parser
POSTGRES_USER=parser
POSTGRES_PASSWORD=parser-local-only

# Running outside Docker: SQLite needs no server.
PARSER_DATABASE_URL=sqlite:///var/parser.sqlite3
# PARSER_DATABASE_URL=postgresql+pg8000://parser:parser-local-only@localhost:5432/parser

# --- Storage and HTTP ---------------------------------------------------------------------
PARSER_ARTIFACT_ROOT=var/artifacts
PARSER_HTTP_HOST=127.0.0.1
PARSER_HTTP_PORT=8000
PARSER_LOG_LEVEL=INFO

# --- Limits (all optional; defaults proposed for the Phase 0 review) ----------------------
PARSER_MAX_FILE_SIZE_BYTES=104857600
PARSER_MAX_PAGES=2000
PARSER_JOB_TIMEOUT_SECONDS=300
PARSER_JOB_MEMORY_LIMIT_MB=2048
PARSER_ARCHIVE_MAX_DEPTH=3
PARSER_ARCHIVE_MAX_FILES=1000
PARSER_ARCHIVE_MAX_EXPANDED_BYTES=1073741824
PARSER_MAX_ATTEMPTS=3
PARSER_QUEUE_CAPACITY=500
PARSER_RETENTION_DAYS=30
PARSER_MIN_FREE_DISK_BYTES=2147483648

# --- Tests only: run the database tests against a real PostgreSQL as well -----------------
# PARSER_TEST_DATABASE_URL=postgresql+pg8000://parser:parser-local-only@localhost:5432/parser_test
